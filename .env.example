# .env.example — variable NAMES only (no secrets). Copy to .env and fill in real values.
# .env and .env.local are gitignored; NEVER commit real secrets. Do not paste secrets in chat.
# Each block maps to a reference in references/*-api.md.

# ── Cloudflare (references/cloudflare-api.md) ───────────────────────────────
# Scoped API token (Bearer). wrangler also reads CLOUDFLARE_API_TOKEN automatically.
#
# A go-live (scripts/cloudflare-go-live.mjs) needs MORE than the original
# Pages-era scope. Add these permission groups to the token, or the script's
# preflight will tell you exactly which are missing:
#   Zone → Zone → Read + Edit          Account → Workers Scripts → Edit
#   Zone → DNS → Edit                  Account → Turnstile → Edit
#   Zone → Dynamic Redirect → Edit     Account → Email Routing Addresses → Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional convenience (look up via GET /zones?name=...):
CLOUDFLARE_ZONE_ID_JSONBEAM=
CLOUDFLARE_ZONE_ID_GRADEJAR=

# ── Resend — transactional email (references/cloudflare-go-live.md §6) ──────
# Free tier: 3,000 emails/month, 100/day. Genuinely free, no card.
# PER CLIENT: the free tier is per Resend ACCOUNT, so each client gets their own
# Resend account and their own 3,000. Do NOT share one key across clients.
# Pass it per-run instead of storing every client's key here:
#   node scripts/cloudflare-go-live.mjs --resend --resend-key=re_xxx ...
# Only set this if you want a default for your OWN projects:
RESEND_API_KEY=

# ── Google AdSense Management API v2 (references/google-adsense-api.md) ──────
# Read-only reporting. OAuth2 3-legged (no service accounts). Get a refresh token once.
ADSENSE_ACCOUNT_ID=            # format: accounts/pub-XXXXXXXXXXXXXXXX
ADSENSE_OAUTH_CLIENT_ID=
ADSENSE_OAUTH_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=

# ── Google Analytics 4 (references/google-analytics-api.md) ─────────────────
GA_PROPERTY_ID=               # format: properties/123456789 (numeric, NOT the G-XXXX tag)
# Preferred: service account JSON (add the SA email as a GA4 property Viewer).
# Keep the JSON file under secrets/ (gitignored) and point at it here:
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4-service-account.json
# OR, if you use OAuth2 instead of a service account:
# GA_OAUTH_CLIENT_ID=
# GA_OAUTH_CLIENT_SECRET=
# GA_REFRESH_TOKEN=

# ── Google Search Console API (reuses the GA4 service account above) ────────
# Add the GA4 service account email as a Restricted user on each property in
# Search Console → Settings → Users and permissions, then enable the Search
# Console API in the same GCP project.
# Domain properties → use "sc-domain:<domain>" (not the https:// form).
# URL-prefix properties → use the exact verified URL, e.g. https://example.com/
GSC_SITE_URL_GRADEJAR=
GSC_SITE_URL_JSONBEAM=
# Domain properties use the sc-domain: form, e.g. sc-domain:accentwallplanner.com
# /gsc-onboard writes GSC_SITE_URL_<SLUG> here automatically for new domains.
GSC_SITE_URL_ACCENTWALLPLANNER=
# Your personal Google account. /gsc-onboard adds it as a property owner so new
# properties show up in YOUR Search Console — the service account has no UI.
GSC_OWNER_EMAIL=

# ── Bing Webmaster Tools (references/bing-webmaster-api.md) ─────────────────
# Search traffic + URL submission/indexing. ONE API key per user covers all verified sites.
# Generate: Bing Webmaster Tools → Settings → API Access → Generate API Key.
BING_WEBMASTER_API_KEY=
# Verified site origins (full URL, must match what you verified in Bing):
BING_SITE_URL_JSONBEAM=https://jsonbeam.com
BING_SITE_URL_GRADEJAR=https://gradejar.com

# ── Reddit Data API (references/reddit-api.md) ──────────────────────────────
# READ-ONLY, app-only OAuth (client_credentials). Monitors subs + reads threads so the
# engine can DRAFT replies. No write scope — posting stays manual. No refresh token needed.
# Create a "script" app at reddit.com/prefs/apps, then paste ID + secret here.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Mandatory + must be honest. Format: <platform>:<appID>:<version> (by /u/<username>)
REDDIT_USER_AGENT=web:tarun-os-marketing:v1.0 (by /u/YOUR_USERNAME)

# ── NOTE: site-side AdSense client (ca-pub-...) does NOT go here. ────────────
# The PUBLIC_ADSENSE_CLIENT that serves ads lives in the GradeJar repo's env
# (set it as a Cloudflare Pages environment variable at go-live), not in this OS repo.
